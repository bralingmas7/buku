
name: Build APK

on:
  push:
    branches: [main, master]
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - uses: actions/checkout@v5

      - uses: actions/setup-java@v5
        with:
          distribution: temurin
          java-version: "21"

      - uses: subosito/flutter-action@v2
        with:
          channel: stable
          cache: true

      # Buat scaffold Android
      - name: Buat scaffold Android
        run: |
          mkdir -p "$RUNNER_TEMP/bak"
          cp -r lib test pubspec.yaml "$RUNNER_TEMP/bak/"

          flutter create --platforms=android \
            --org id.warung \
            --project-name buku_utang_warung .

          rm -rf lib test pubspec.yaml
          cp -r "$RUNNER_TEMP/bak/lib" lib
          cp -r "$RUNNER_TEMP/bak/test" test
          cp "$RUNNER_TEMP/bak/pubspec.yaml" pubspec.yaml

          sed -i 's/android:label="[^"]*"/android:label="Buku Utang Warung"/' \
            android/app/src/main/AndroidManifest.xml

      # Ambil keystore dari GitHub Secrets
      - name: Siapkan keystore
        env:
          KEYSTORE_BASE64: ${{ secrets.KEYSTORE_BASE64 }}
        run: |
          if [ -z "$KEYSTORE_BASE64" ]; then
            echo "KEYSTORE_BASE64 belum tersedia"
            exit 1
          fi

          printf '%s' "$KEYSTORE_BASE64" \
            | base64 --decode > android/app/upload-keystore.jks

          test -s android/app/upload-keystore.jks

      # Atur signing Gradle
      - name: Konfigurasi signing Gradle
        run: |
          python3 - <<'PY'
          from pathlib import Path
          import re

          paths = [
              Path("android/app/build.gradle.kts"),
              Path("android/app/build.gradle")
          ]

          path = next((p for p in paths if p.exists()), None)
          if path is None:
              raise SystemExit("File Gradle Android tidak ditemukan")

          text = path.read_text()
          is_kts = path.suffix == ".kts"

          if is_kts:
              imports = (
                  "import java.util.Properties\n"
              )
              if "import java.util.Properties" not in text:
                  text = imports + text

              block = """
              signingConfigs {
                  create("release") {
                      keyAlias = System.getenv("KEY_ALIAS")
                          ?: error("KEY_ALIAS missing")
                      keyPassword = System.getenv("KEY_PASSWORD")
                          ?: error("KEY_PASSWORD missing")
                      storeFile = file(
                          System.getenv("KEYSTORE_FILE")
                              ?: error("KEYSTORE_FILE missing")
                      )
                      storePassword = System.getenv("KEYSTORE_PASSWORD")
                          ?: error("KEYSTORE_PASSWORD missing")
                  }
              }
              """
          else:
              block = """
              signingConfigs {
                  release {
                      keyAlias System.getenv('KEY_ALIAS')
                      keyPassword System.getenv('KEY_PASSWORD')
                      storeFile file(System.getenv('KEYSTORE_FILE'))
                      storePassword System.getenv('KEYSTORE_PASSWORD')
                  }
              }
              """

          if "signingConfigs {" in text:
              raise SystemExit("signingConfigs sudah ada; hentikan agar tidak duplikat")

          text, count = re.subn(
              r'android\s*\{',
              lambda m: m.group(0) + block,
              text,
              count=1
          )
          if count != 1:
              raise SystemExit("Blok android tidak ditemukan")

          patterns = (
              [
                  r'(?m)^([ \t]*)signingConfig\s*=\s*signingConfigs\.getByName\("debug"\)\s*$',
                  r'(?m)^([ \t]*)signingConfig\s*=\s*signingConfigs\.debug\s*$'
              ] if is_kts else [
                  r'(?m)^([ \t]*)signingConfig\s+signingConfigs\.debug\s*$',
                  r'(?m)^([ \t]*)signingConfig\s*=\s*signingConfigs\.debug\s*$'
              ]
          )

          replaced = False
          for pattern in patterns:
              text, count = re.subn(
                  pattern,
                  lambda m: m.group(1) + (
                      'signingConfig = signingConfigs.getByName("release")'
                      if is_kts else
                      'signingConfig signingConfigs.release'
                  ),
                  text
              )
              if count:
                  replaced = True
                  break

          if not replaced:
              raise SystemExit(
                  "Konfigurasi signing debug tidak ditemukan. "
                  "Build dihentikan agar tidak memakai sertifikat yang salah."
              )

          path.write_text(text)
          print("Signing release berhasil dikonfigurasi:", path)
          PY

      - name: Install dependency
        run: flutter pub get

      - name: Jalankan test
        run: flutter test

      # Build menggunakan keystore permanen
      - name: Build APK release
        env:
          KEYSTORE_FILE: upload-keystore.jks
          KEYSTORE_PASSWORD: ${{ secrets.KEYSTORE_PASSWORD }}
          KEY_ALIAS: ${{ secrets.KEY_ALIAS }}
          KEY_PASSWORD: ${{ secrets.KEY_PASSWORD }}
        run: |
          flutter build apk --release

      # Verifikasi sertifikat APK
      - name: Verifikasi APK
        run: |
          APKSIGNER=$(find "$ANDROID_HOME/build-tools" \
            -type f -name apksigner | sort -V | tail -n 1)

          "$APKSIGNER" verify --print-certs \
            build/app/outputs/flutter-apk/app-release.apk

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: buku-utang-warung-apk
          path: build/app/outputs/flutter-apk/app-release.apk
